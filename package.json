{
  "name": "shift-the-timeline",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "SHIFT_CASE_FILE=private/train-case.en-GB.mjs node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "dev:demo": "SHIFT_CASE_FILE=tests/fixtures/case.mjs node server/index.mjs",
    "test:browser": "node tests/browser-chat.mjs && node tests/browser-recovery.mjs && node tests/browser-public-demo.mjs && node tests/browser-guidance.mjs && node tests/browser-notebook.mjs && node tests/browser-room-switch.mjs && node tests/browser-ai-reading.mjs && node tests/browser-conversation-memory.mjs && node tests/browser-suspect-files.mjs && node tests/browser-evidence-search.mjs && node tests/browser-audio.mjs",
    "check:case": "node scripts/check-case.mjs",
    "dev:ai": "node server/local-ai-index.mjs",
    "dev:public-demo": "SHIFT_CASE_FILE=examples/public-demo.mjs node server/index.mjs",
    "check:public-demo": "SHIFT_CASE_FILE=examples/public-demo.mjs node scripts/check-case.mjs",
    "eval:interviews": "node scripts/evaluate-interviews.mjs",
    "package:azure": "node scripts/package-azure.mjs",
    "start:azure": "node server/azure-index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/client-secrets-manager": "3.1165.0",
    "@aws-sdk/client-sqs": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "@azure/identity": "4.14.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.1"
  }
}
